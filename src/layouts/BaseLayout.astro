---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono';
import ExternalLink from '../components/ExternalLink.astro';
import Header from '../components/Header.astro';
import { productionHost } from '../lib/analytics';
import { owner, pageTitle, previewImage } from '../lib/site';
import '../styles/global.css';

interface Props {
	/** Page name for the browser tab; omit on Home. */
	title?: string;
	/** Summary for search results and link previews. */
	description?: string;
}

const { title, description = owner.description } = Astro.props;
// Link previews need an absolute URL. It points at production even on a preview deploy, which is never shared.
const previewImageUrl = new URL(previewImage.path, `https://${productionHost}`).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle(title)} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={previewImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={String(previewImage.width)} />
		<meta property="og:image:height" content={String(previewImage.height)} />
		<meta property="og:image:alt" content={previewImage.alt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image:alt" content={previewImage.alt} />
		<script is:inline>
			// Runs before first paint: mark JS support and apply the stored or system theme, so there is no flash.
			document.documentElement.classList.add('js');
			let theme;
			try {
				theme = localStorage.getItem('theme');
			} catch {}
			if (theme !== 'dark' && theme !== 'light') {
				theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			}
			document.documentElement.dataset.theme = theme;
		</script>
		<title>{pageTitle(title)}</title>
	</head>
	<body class="flex min-h-dvh flex-col">
		<Header />
		<main class="flex-1">
			{
				Astro.slots.has('hero') && (
					<section class="page-hero">
						<div class="mx-auto max-w-page px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
							<slot name="hero" />
						</div>
					</section>
				)
			}
			{
				Astro.slots.has('default') && (
					<div class="page-body mx-auto max-w-page px-4 pt-10 pb-20 sm:px-6 sm:pt-12">
						<slot />
					</div>
				)
			}
		</main>
		<footer class="border-t border-rule">
			<div class="mx-auto grid max-w-page gap-6 px-4 py-10 sm:px-6 md:grid-cols-[1fr_auto] md:items-end">
				<div>
					<p class="font-wide text-lg font-bold">{owner.name}</p>
					<p class="mt-1 max-w-md text-ink-2">
						Built with Astro and tested with Playwright before every release. See the <a class="link" href="/quality"
							>latest results</a
						>.
					</p>
				</div>
				<ul class="flex flex-wrap gap-x-6 gap-y-2 font-semibold">
					<li><ExternalLink class="link" href={owner.links.github}>GitHub</ExternalLink></li>
					<li><ExternalLink class="link" href={owner.links.linkedin}>LinkedIn</ExternalLink></li>
					<li><a class="link" href={owner.resume} download>Résumé (PDF)</a></li>
				</ul>
				<p class="text-sm text-ink-2 md:col-span-2">
					© {owner.name}. The <ExternalLink class="link font-normal" href={owner.links.source}>code</ExternalLink> is MIT
					licensed; the text and résumé are all rights reserved.
				</p>
			</div>
		</footer>
		<script>
			// Cookieless page-view counts, for real Visitors on the live site only (see src/lib/analytics.ts).
			import { beaconSrc, shouldCountVisit } from '../lib/analytics';
			import { webAnalyticsToken } from '../lib/site';

			if (shouldCountVisit(webAnalyticsToken, location.hostname, navigator.webdriver)) {
				// As Cloudflare's own snippet loads it: a module script with its settings in data-cf-beacon.
				const beacon = document.createElement('script');
				beacon.type = 'module';
				beacon.src = beaconSrc;
				beacon.dataset.cfBeacon = JSON.stringify({ token: webAnalyticsToken });
				document.head.append(beacon);
			}
		</script>
		<script>
			// Motion for every page. All of it is skipped for Visitors who prefer reduced motion, and content
			// is never hidden without JavaScript (the reveal styles apply only under html.js).
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

			// Elements marked data-reveal slide in the first time they scroll into view.
			const reveal = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						entry.target.classList.add('is-in');
						reveal.unobserve(entry.target);
						entry.target.querySelectorAll<HTMLElement>('[data-count-to]').forEach(countUp);
					}
				},
				{ rootMargin: '0px 0px -6% 0px' },
			);
			document.querySelectorAll('[data-reveal]').forEach((element) => reveal.observe(element));

			/** Counts a figure from data-count-from to data-count-to, easing out. */
			function countUp(element: HTMLElement) {
				const to = Number(element.dataset.countTo);
				const from = Number(element.dataset.countFrom ?? 0);
				const decimals = Number(element.dataset.decimals ?? 0);
				if (reduce) return;
				const start = performance.now() + 250;
				element.textContent = from.toFixed(decimals);
				const tick = (now: number) => {
					const t = Math.min(Math.max((now - start) / 1400, 0), 1);
					element.textContent = (from + (to - from) * (1 - Math.pow(1 - t, 3))).toFixed(decimals);
					if (t < 1) requestAnimationFrame(tick);
				};
				requestAnimationFrame(tick);
			}

			// Cards and bands marked data-spotlight glow where the pointer is.
			for (const element of document.querySelectorAll<HTMLElement>('[data-spotlight]')) {
				element.addEventListener('pointermove', (event) => {
					const box = element.getBoundingClientRect();
					element.style.setProperty('--mx', `${event.clientX - box.left}px`);
					element.style.setProperty('--my', `${event.clientY - box.top}px`);
				});
			}
		</script>
	</body>
</html>
