---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono';
import ExternalLink from '../components/ExternalLink.astro';
import Header from '../components/Header.astro';
import { owner, pageTitle } from '../lib/site';
import '../styles/global.css';

interface Props {
	/** Page name for the browser tab; omit on Home. */
	title?: string;
	/** Summary for search results and link previews. */
	description?: string;
}

const { title, description = owner.description } = Astro.props;
const year = new Date().getFullYear();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle(title)} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<script is:inline>
			// Runs before first paint: mark JS support and apply the stored or system theme, so there is no flash.
			document.documentElement.classList.add('js');
			let theme;
			try {
				theme = localStorage.getItem('theme');
			} catch {}
			if (theme !== 'dark' && theme !== 'light') {
				theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			}
			document.documentElement.dataset.theme = theme;
		</script>
		<title>{pageTitle(title)}</title>
	</head>
	<body class="flex min-h-dvh flex-col">
		<Header />
		<main class="flex-1">
			{
				Astro.slots.has('hero') && (
					<section class="page-hero border-b border-rule">
						<div class="mx-auto max-w-page px-4 pt-12 pb-10 sm:px-6 sm:pt-16 sm:pb-12">
							<slot name="hero" />
						</div>
					</section>
				)
			}
			{
				Astro.slots.has('default') && (
					<div class="page-body mx-auto max-w-page px-4 pt-10 pb-20 sm:px-6 sm:pt-12">
						<slot />
					</div>
				)
			}
		</main>
		<footer class="border-t border-rule">
			<div class="mx-auto grid max-w-page gap-6 px-4 py-10 sm:px-6 md:grid-cols-[1fr_auto] md:items-end">
				<div>
					<p class="font-wide text-lg font-bold">{owner.name}</p>
					<p class="mt-1 max-w-md text-ink-2">
						Built with Astro and tested with Playwright before every release. See the <a class="link" href="/quality"
							>latest results</a
						>.
					</p>
				</div>
				<ul class="flex flex-wrap gap-x-6 gap-y-2 font-semibold">
					<li><ExternalLink class="link" href={owner.links.github}>GitHub</ExternalLink></li>
					<li><ExternalLink class="link" href={owner.links.linkedin}>LinkedIn</ExternalLink></li>
					<li><a class="link" href={owner.resume} download>Résumé (PDF)</a></li>
				</ul>
				<p class="text-sm text-ink-2 md:col-span-2">
					© {year} {owner.name}. The <ExternalLink class="link font-normal" href={owner.links.source}>code</ExternalLink> is MIT
					licensed; the text and résumé are all rights reserved.
				</p>
			</div>
		</footer>
	</body>
</html>
