---
import ExternalLink from '../components/ExternalLink.astro';
import TestLabel from '../components/TestLabel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { reports } from '../lib/site';

const kinds = [
	{ kind: 'gate', name: 'Gate run', what: 'Every change is tested on a preview deploy, in three browsers and a phone, before it can be released.' },
	{ kind: 'smoke', name: 'Smoke run', what: 'After each release, a shorter suite checks the live site.' },
] as const;
---

<BaseLayout title="Quality dashboard" description="The real, latest test results for this site: every release is tested in Chromium, Firefox, WebKit and on a phone before it goes live.">
	<Fragment slot="hero">
		<h1>Quality dashboard</h1>
		<p class="lede">
			Every release of this site is tested before it goes live. These are the real results, loaded from the reports
			site.
		</p>
		<p class="overall" role="status" data-state="loading">Loading the latest results…</p>
		<noscript><p class="overall">See the results on the <ExternalLink href={reports.site}>reports site</ExternalLink>.</p></noscript>
	</Fragment>

	<section class="release" aria-labelledby="release-heading" data-reveal>
		<TestLabel check="latestRelease" />
		<h2 id="release-heading">The latest Release</h2>
		<p class="release-what">
			Each change goes live in three steps: a Gate run on a preview deploy, promotion of that same deploy if it passes,
			then a Smoke run on the live site.
		</p>
		<div class="stage" data-tilt="4">
			<ol class="track">
				{
					kinds.map(({ kind, name, what }, i) => (
						<Fragment>
							{i === 1 && (
								<li class="step">
									<section class="tile promotion" aria-labelledby="promotion-heading">
										<span class="promotion-mark" aria-hidden="true" />
										<h3 id="promotion-heading">Promotion</h3>
										<p class="run-what">Only a Gate run that passes promotes its deploy to the live site.</p>
										<p class="promotion-state" data-promotion-state />
									</section>
								</li>
							)}
							<li class="step">
								<section class="tile run-card" aria-labelledby={`${kind}-heading`}>
									<h3 id={`${kind}-heading`}>{name}</h3>
									<p class="run-what">{what}</p>
									<div class="run-body" data-card={kind}>
										<p class="muted loading">Loading…</p>
									</div>
								</section>
							</li>
						</Fragment>
					))
				}
			</ol>
		</div>
	</section>

	<section class="history" aria-labelledby="history-heading">
		<h2 id="history-heading">Last 30 runs</h2>
		{
			kinds.map(({ kind, name }) => (
				<section class="trend" aria-labelledby={`${kind}-trend-heading`}>
					<div class="trend-head">
						<h3 id={`${kind}-trend-heading`}>{name} history</h3>
						<p class="trend-summary" data-trend-summary={kind} />
					</div>
					<ol class="bars" data-trend={kind} />
				</section>
			))
		}
		<p class="legend">
			<span class="legend-item"><span class="swatch passed" aria-hidden="true" />Passed</span>
			<span class="legend-item"><span class="swatch failed" aria-hidden="true" />Failed</span>
			<span>Older runs on the left. Select a bar to open its report.</span>
		</p>
		<div class="tooltip" id="trend-tooltip" role="tooltip" hidden></div>
		<details class="table-view">
			<summary>Show every run as a table</summary>
			<div class="table-scroll">
				<table>
					<thead>
						<tr><th scope="col">Run</th><th scope="col">Started (UTC)</th><th scope="col">Result</th><th scope="col">Passed</th><th scope="col">Failed</th><th scope="col">Flaky</th><th scope="col">Report</th></tr>
					</thead>
					<tbody data-table />
				</table>
			</div>
		</details>
	</section>

	<p class="source">
		Data: <ExternalLink href={reports.summaryUrl}>summary.json</ExternalLink> on the <ExternalLink href={reports.site}>reports site</ExternalLink>.
	</p>
</BaseLayout>

<script>
	import { dashboardView, type DashboardView, type RunCard, type TableRow } from '../lib/quality-dashboard';
	import { reports } from '../lib/site';
	import type { RunKind } from '../lib/test-runs';

	function el<K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]> = {}, ...children: (Node | string)[]) {
		const node = Object.assign(document.createElement(tag), props);
		node.append(...children);
		return node;
	}

	/** A link to another website, matching ExternalLink.astro. */
	function externalLink(href: string, text: string, className = '') {
		const link = el('a', { href, target: '_blank', rel: 'noopener noreferrer', className: `external-link ${className}`.trim() }, text);
		link.append(el('span', { className: 'sr-only' }, ' (opens in a new tab)'), el('span', { className: 'external-icon', ariaHidden: 'true' }, '↗'));
		return link;
	}

	function statusChip(status: RunCard['status']) {
		return el(
			'span',
			{ className: `chip ${status}` },
			el('span', { className: 'chip-icon', ariaHidden: 'true' }, status === 'passed' ? '✓' : '✗'),
			status === 'passed' ? 'Passed' : 'Failed',
		);
	}

	/** A run's tile. It takes the pass or fail colour only once it shows a real result. */
	function renderCard(kind: RunKind, view: DashboardView | undefined) {
		const body = document.querySelector<HTMLElement>(`[data-card="${kind}"]`);
		const tile = body?.closest<HTMLElement>('.tile');
		if (!body || !tile) return;
		const run = view?.latest[kind];
		if (!run) {
			delete tile.dataset.result;
			body.replaceChildren(
				view
					? el('p', { className: 'muted' }, 'No runs yet.')
					: el('p', { className: 'muted' }, "Couldn't load this run. See it on the ", externalLink(reports.site, 'reports site'), '.'),
			);
			return;
		}
		tile.dataset.result = run.status;
		const time = el('time', { dateTime: run.startedAt, title: run.startedAt }, run.when);
		const { passed, failed, flaky, skipped } = run.counts;
		const earlier = kind === 'smoke' && !!view.latest.gate && !view.release.smokeFromThisRelease;
		if (earlier) tile.dataset.release = 'earlier';
		else delete tile.dataset.release;
		body.replaceChildren(
			...(earlier ? [el('p', { className: 'earlier' }, 'From an earlier Release')] : []),
			el('p', { className: 'run-status' }, statusChip(run.status), time),
			el('p', { className: 'counts' }, `${passed} passed · ${failed} failed · ${flaky} flaky · ${skipped} skipped`),
			el('p', { className: 'muted' }, `Took ${run.duration} · commit `, externalLink(run.commitUrl, run.commit)),
			el('ul', { className: 'tags', ariaLabel: 'Browsers' }, ...run.projects.map((project) => el('li', {}, project))),
			el('p', { className: 'run-links' }, externalLink(run.reportUrl, 'Open report', 'btn btn-primary'), externalLink(run.runUrl, 'GitHub run', 'btn btn-secondary')),
		);
	}

	/**
	 * Promotion has no test result of its own, so it never turns green or red: it lights up in the
	 * accent colour when the Gate run passed, and stays dim when it failed. Without a Gate run (or
	 * without results at all) it is left as it was served: neither lit nor dim.
	 */
	function renderPromotion(view: DashboardView | undefined) {
		const state = document.querySelector<HTMLElement>('[data-promotion-state]');
		const tile = state?.closest<HTMLElement>('.tile');
		if (!state || !tile) return;
		if (!view?.latest.gate) {
			delete tile.dataset.promoted;
			state.replaceChildren();
			return;
		}
		const { promoted, smokeFromThisRelease } = view.release;
		tile.dataset.promoted = String(promoted);
		// "Went live" only once its own Smoke run proves it; until then the Gate run only cleared it.
		const detail = !promoted
			? ' The Gate run failed, so nothing went live.'
			: smokeFromThisRelease
				? ' The deploy that passed went live.'
				: ' The Gate run passed, so this change was cleared to go live.';
		state.replaceChildren(el('strong', {}, promoted ? 'Promoted' : 'Not promoted'), detail);
	}

	function renderTrend(kind: RunKind, trend: DashboardView['trend'][RunKind]) {
		const summary = document.querySelector(`[data-trend-summary="${kind}"]`);
		const bars = document.querySelector(`[data-trend="${kind}"]`);
		if (summary) summary.textContent = trend.points.length ? trend.passedLabel : 'No runs yet.';
		bars?.replaceChildren(
			...trend.points.map((point) =>
				el('li', {}, el('a', { className: `bar ${point.status}`, href: point.reportUrl, target: '_blank', rel: 'noopener noreferrer', ariaLabel: `${point.label} (opens in a new tab)` })),
			),
		);
		bars?.querySelectorAll<HTMLAnchorElement>('.bar').forEach((bar, i) => {
			bar.dataset.label = trend.points[i].label;
		});
	}

	function renderTable(rows: TableRow[]) {
		document.querySelector('[data-table]')?.replaceChildren(
			...rows.map((row) =>
				el(
					'tr',
					{},
					el('td', {}, row.kind),
					el('td', {}, row.startedAt.slice(0, 16).replace('T', ' ')),
					el('td', {}, statusChip(row.status)),
					el('td', {}, String(row.counts.passed)),
					el('td', {}, String(row.counts.failed)),
					el('td', {}, String(row.counts.flaky)),
					el('td', {}, externalLink(row.reportUrl, 'Open')),
				),
			),
		);
	}

	function renderOverall(view: DashboardView | undefined) {
		const status = document.querySelector<HTMLElement>('.overall[role="status"]');
		if (!status) return;
		const smoke = view?.latest.smoke;
		const gate = view?.latest.gate;
		const messages: Record<string, [string, string]> = {
			healthy: ['All checks passing.', ` The live site passed its latest Smoke run ${smoke?.when ?? ''}.`],
			'production-failing': ['Production check failing.', ` The latest Smoke run on the live site failed ${smoke?.when ?? ''}.`],
			'release-blocked': ['Latest release blocked.', ` The Gate run caught a problem ${gate?.when ?? ''}, so the live site is still on the last build that passed.`],
		};
		const state = view && view.overall !== 'no-data' ? view.overall : 'unavailable';
		status.dataset.state = state;
		if (state === 'unavailable') {
			status.replaceChildren(el('strong', {}, "Couldn't load the latest results."), ' The reports site may be briefly unavailable. See every run on the ', externalLink(reports.site, 'reports site'), '.');
			return;
		}
		const [headline, detail] = messages[state];
		status.replaceChildren(el('strong', {}, headline), detail);
	}

	/** One tooltip for every trend bar: shown on hover and keyboard focus, dismissed with Escape. */
	function wireTooltip() {
		const tooltip = document.getElementById('trend-tooltip');
		if (!tooltip) return;
		const show = (bar: HTMLElement) => {
			tooltip.textContent = bar.dataset.label ?? '';
			tooltip.hidden = false;
			const box = bar.getBoundingClientRect();
			const width = tooltip.offsetWidth;
			const left = Math.min(Math.max(8, box.left + box.width / 2 - width / 2), document.documentElement.clientWidth - width - 8);
			tooltip.style.left = `${left + scrollX}px`;
			tooltip.style.top = `${box.top + scrollY - tooltip.offsetHeight - 8}px`;
		};
		const hide = () => (tooltip.hidden = true);
		document.querySelectorAll<HTMLElement>('.bar').forEach((bar) => {
			bar.addEventListener('pointerenter', () => show(bar));
			bar.addEventListener('focus', () => show(bar));
			bar.addEventListener('pointerleave', hide);
			bar.addEventListener('blur', hide);
		});
		document.addEventListener('keydown', (event) => event.key === 'Escape' && hide());
	}

	async function load() {
		let view: DashboardView | undefined;
		try {
			const response = await fetch(reports.summaryUrl, { cache: 'no-store' });
			if (response.ok) view = dashboardView(await response.json(), new Date());
		} catch {
			view = undefined;
		}
		renderOverall(view);
		const kinds: RunKind[] = ['gate', 'smoke'];
		renderPromotion(view);
		for (const kind of kinds) {
			renderCard(kind, view);
			renderTrend(kind, view?.trend[kind] ?? { points: [], passedLabel: '' });
		}
		renderTable(view?.table ?? []);
		wireTooltip();
	}

	load();
</script>

<style>
	.overall {
		max-width: 46rem;
		margin: 1.75rem 0 0;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--rule);
		border-left: 5px solid var(--ink-2);
		border-radius: 0.75rem;
		background: var(--surface);
		color: var(--ink);
	}
	.overall[data-state='healthy'] {
		border-left-color: var(--pass);
	}
	.overall[data-state='production-failing'],
	.overall[data-state='release-blocked'] {
		border-left-color: var(--fail);
	}
	.overall :global(strong) {
		font-weight: 700;
	}
	.overall :global(a) {
		color: var(--accent);
		text-decoration: underline;
	}
	/* ---------- The latest Release: Gate run, promotion, Smoke run, standing on a tilted rail ---------- */
	.release > h2 {
		font-size: clamp(1.625rem, 4vw, 2.125rem);
		font-stretch: 115%;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}
	.release-what {
		max-width: 46rem;
		margin: 0.6rem 0 0;
		color: var(--ink-2);
	}
	.stage {
		--rx: 0deg;
		--ry: 0deg;
		margin-top: 1.75rem;
		perspective: 1600px;
	}
	.track {
		position: relative;
		display: grid;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		transform: rotateX(calc(7deg + var(--rx))) rotateY(var(--ry));
		transform-origin: 50% 100%;
		transform-style: preserve-3d;
	}
	/* The rail every step stands on, from the Gate run to the Smoke run. Lit once the change is promoted. */
	.track::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 2px;
		translate: -50% 0;
		background: color-mix(in srgb, var(--accent) 35%, var(--rule));
		transform: translateZ(-30px);
	}
	.track:has([data-promoted='true'])::before {
		background: linear-gradient(var(--accent), var(--glow));
		box-shadow: 0 0 16px var(--glow);
	}
	/* A Smoke run from an earlier Release isn't joined to this one. */
	.track:has([data-release='earlier'])::before {
		background: repeating-linear-gradient(var(--accent) 0 6px, transparent 6px 12px);
		box-shadow: none;
	}
	.step {
		display: grid;
		transform-style: preserve-3d;
	}
	.tile {
		/* A tile's edge: the accent until it shows a real result. */
		--edge: var(--accent);
		position: relative;
		display: grid;
		align-content: start;
		gap: 0.5rem;
		padding: 1.5rem 1.25rem;
		border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--rule));
		border-top: 3px solid var(--edge);
		border-radius: 1.25rem;
		background: color-mix(in srgb, var(--surface) 94%, var(--accent));
		box-shadow:
			0 30px 60px -36px color-mix(in srgb, var(--glow) 80%, transparent),
			inset 0 1px 0 rgb(255 255 255 / 0.08);
		transform: translateZ(24px);
	}
	/* Green and red only ever report a real result, and the tile's chip says it in words with an icon. */
	.tile[data-result='passed'] {
		--edge: var(--pass);
	}
	.tile[data-result='failed'] {
		--edge: var(--fail);
	}
	@media (min-width: 40rem) {
		.tile {
			padding: 1.75rem;
		}
	}
	.tile h3 {
		font-size: 1.5rem;
		font-stretch: 110%;
		font-weight: 800;
		letter-spacing: -0.015em;
	}
	.promotion {
		gap: 0.4rem;
		text-align: center;
		justify-items: center;
		padding-block: 1.25rem;
	}
	.promotion h3 {
		font-size: 1.125rem;
	}
	.promotion-mark {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 2px solid var(--accent);
		border-radius: 50%;
	}
	.promotion-mark::before {
		content: '';
		width: 0.6rem;
		height: 0.6rem;
		border-top: 2px solid var(--accent);
		border-right: 2px solid var(--accent);
		rotate: 135deg;
		translate: 0 -0.15rem;
	}
	.promotion-state {
		min-height: 2.6em;
		margin: 0;
		color: var(--ink);
		font-size: 0.9rem;
	}
	.promotion-state :global(strong) {
		display: block;
		font-weight: 700;
	}
	/* Promoted: lit in the accent, never green, since promotion is not a test result. */
	.promotion[data-promoted='true'] {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--surface) 84%, var(--accent));
		box-shadow:
			0 0 0 1px var(--accent),
			0 24px 60px -20px var(--glow);
	}
	.promotion[data-promoted='true'] .promotion-mark {
		background: var(--accent);
		box-shadow: 0 0 18px var(--glow);
	}
	.promotion[data-promoted='true'] .promotion-mark::before {
		border-color: var(--on-accent);
	}
	/* Not promoted: dim and dashed, sitting lower on the rail. */
	.promotion[data-promoted='false'] {
		border-style: dashed;
		border-top-style: dashed;
		background: var(--surface);
		box-shadow: none;
		transform: translateZ(4px);
	}
	.promotion[data-promoted='false'] .promotion-mark {
		border-style: dashed;
		border-color: var(--ink-2);
	}
	.promotion[data-promoted='false'] .promotion-mark::before {
		border-color: var(--ink-2);
	}
	.run-body :global(.earlier) {
		justify-self: start;
		padding: 0.1rem 0.6rem;
		border: 1px dashed var(--accent);
		border-radius: 999px;
		color: var(--ink);
		font-size: 0.8rem;
		font-weight: 600;
	}
	/* Wide screens: the three steps side by side, the rail running across them. */
	@media (min-width: 64rem) {
		.track {
			grid-template-columns: minmax(0, 1fr) 13rem minmax(0, 1fr);
			align-items: center;
			gap: 1.25rem;
		}
		.track::before {
			top: 50%;
			bottom: auto;
			left: 0;
			right: 0;
			width: auto;
			height: 2px;
			translate: 0 -50%;
		}
		.track:has([data-release='earlier'])::before {
			background: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 12px);
		}
		.promotion-mark::before {
			rotate: 45deg;
			translate: -0.15rem 0;
		}
	}
	@media screen and (prefers-reduced-motion: no-preference) {
		.track {
			transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
		}
		.tile {
			transition:
				transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
				box-shadow 0.4s ease;
		}
		.tile:hover,
		.tile:focus-within {
			transform: translateZ(44px);
		}
		/* Once promoted, a light travels down the rail towards the live site. The pseudo-element is as
		   long as the rail, with the light at its far end, so it moves with a transform (no repaints). */
		.track:has([data-promoted='true'])::after {
			content: '';
			position: absolute;
			top: 0;
			left: 50%;
			width: 10px;
			height: 100%;
			margin-left: -5px;
			background: radial-gradient(circle at 50% calc(100% - 5px), var(--accent) 3px, color-mix(in srgb, var(--glow) 60%, transparent) 4px, transparent 5px);
			pointer-events: none;
			animation: down-the-rail 3.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
		}
		@media (min-width: 64rem) {
			.track:has([data-promoted='true'])::after {
				top: 50%;
				left: 0;
				width: 100%;
				height: 10px;
				margin: -5px 0 0;
				background: radial-gradient(circle at calc(100% - 5px) 50%, var(--accent) 3px, color-mix(in srgb, var(--glow) 60%, transparent) 4px, transparent 5px);
				animation-name: along-the-rail;
			}
		}
	}
	@keyframes down-the-rail {
		from {
			translate: 0 -100%;
			opacity: 0;
		}
		15%,
		85% {
			opacity: 1;
		}
		to {
			translate: 0 0;
			opacity: 0;
		}
	}
	@keyframes along-the-rail {
		from {
			translate: -100% 0;
			opacity: 0;
		}
		15%,
		85% {
			opacity: 1;
		}
		to {
			translate: 0 0;
			opacity: 0;
		}
	}
	/* Without JavaScript there are no results to wait for. */
	:global(html:not(.js)) .run-body .loading {
		display: none;
	}
	/* With it, each run tile keeps room for its results, so they don't push the page down as they load. */
	:global(html.js) .run-body {
		min-height: 11.5rem;
		align-content: start;
	}
	.run-body :global(.muted) {
		color: var(--ink-2);
		font-size: 0.9rem;
	}
	.run-body :global(.muted a) {
		color: var(--accent);
		text-decoration: underline;
	}
	/* Phones: less tilt, so the tiles keep their width. */
	@media (max-width: 39.999rem) {
		.track {
			transform: rotateX(calc(4deg + var(--rx))) rotateY(var(--ry));
		}
	}
	.run-what,
	.muted {
		margin: 0;
		color: var(--ink-2);
		font-size: 0.9rem;
	}
	.run-body {
		display: grid;
		gap: 0.6rem;
		margin-top: 0.5rem;
	}
	.run-body :global(p) {
		margin: 0;
	}
	.run-body :global(.run-status) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		color: var(--ink-2);
	}
	.run-body :global(.counts) {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
	}
	.run-body :global(.run-links) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 0.25rem;
	}
	:global(.chip) {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.15rem 0.7rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		color: var(--ink);
		font-weight: 600;
		font-size: 0.85rem;
	}
	:global(.chip-icon) {
		display: inline-grid;
