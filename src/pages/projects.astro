---
import { getCollection } from 'astro:content';
import EntryCard from '../components/EntryCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projectAreas } from '../lib/content-schemas';
import { newestFirst } from '../lib/dates';

const projects = newestFirst(await getCollection('projects'));

const intros: Record<(typeof projectAreas)[number], string> = {
	'Test automation': 'My day job, and how this site tests itself.',
	Backend: "Java and Spring Boot services and low-level designs, built during Scaler's backend course.",
	'Full stack': 'Apps with TypeScript on both the frontend and the backend.',
};

const groups = projectAreas
	.map((area) => ({ area, id: `area-${area.toLowerCase().replaceAll(' ', '-')}`, intro: intros[area], items: projects.filter((project) => project.data.area === area) }))
	.filter((group) => group.items.length > 0);
---

<BaseLayout title="Projects" description="Test automation, backend and full-stack projects by Piyush Sinha, each with its source code.">
	<Fragment slot="hero">
		<h1>Projects</h1>
		<p class="lede">Things I've built, each with its source code. Test automation comes first; the backend and full-stack work is what I'm growing into.</p>
	</Fragment>
	<div class="grid gap-16">
		{
			groups.map(({ area, id, intro, items }) => (
				<section aria-labelledby={id}>
					<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-t-2 border-ink pt-4">
						<h2 id={id} class="font-wide text-2xl font-extrabold tracking-tight">
							{area}
						</h2>
						<p class="text-ink-2">{intro}</p>
					</div>
					<div class="mt-3 grid" data-testid="entry-list">
						{items.map((project) => (
							<EntryCard
								layout="row"
								level={3}
								title={project.data.title}
								href={`/projects/${project.id}`}
								summary={project.data.summary}
								date={project.data.date}
								tags={project.data.tags}
							/>
						))}
					</div>
				</section>
			))
		}
	</div>
</BaseLayout>
