---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EntryMeta from '../../components/EntryMeta.astro';
import TestLabel from '../../components/TestLabel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { transitionName } from '../../lib/transitions';

export async function getStaticPaths() {
	const caseStudies = await getCollection('caseStudies');
	return caseStudies.map((caseStudy) => ({ params: { slug: caseStudy.id }, props: { caseStudy } }));
}

interface Props {
	caseStudy: CollectionEntry<'caseStudies'>;
}

const { caseStudy } = Astro.props;
const { Content } = await render(caseStudy);
---

<BaseLayout title={caseStudy.data.title} description={caseStudy.data.problem}>
	<Fragment slot="hero">
		<p class="mb-5"><a class="link" href="/case-studies">All case studies</a></p>
		<h1 class="title-long" style={`view-transition-name: ${transitionName(`/case-studies/${caseStudy.id}`)}`}>
			{caseStudy.data.title}
		</h1>
		<EntryMeta date={caseStudy.data.date} tags={caseStudy.data.tags} />
	</Fragment>
	<div class="frame grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:gap-16">
		<div>
			<TestLabel check="caseStudyStory" />
			<article class="prose">
				<h2>Problem</h2>
				<p>{caseStudy.data.problem}</p>
				<h2>Approach</h2>
				<p>{caseStudy.data.approach}</p>
				<h2>Outcome</h2>
				<p>{caseStudy.data.outcome}</p>
				<Content />
			</article>
		</div>
		<aside class="self-start lg:sticky lg:top-24">
			<div class="panel p-6" data-spotlight>
				{
					caseStudy.data.highlight && (
						<div class="mb-5 border-b border-rule pb-5">
							<p class="text-sm font-semibold text-ink-2">Headline result</p>
							<p class="headline mt-2 font-wide text-xl leading-tight font-extrabold">
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
									<path d="M5 12.5l4.5 4.5L19 7.5" />
								</svg>
								<span>{caseStudy.data.highlight}</span>
							</p>
						</div>
					)
				}
				<h2 class="font-wide text-lg font-bold">About this case study</h2>
				<p class="mt-2 text-[0.9375rem] text-ink-2">
					Work from my time as an SDET. The employer, client and any confidential details are left out; the numbers are
					the ones I can share.
				</p>
				<div class="mt-5 grid gap-3">
					<a class="btn btn-primary" href="/contact">Ask me about it</a>
					<a class="btn btn-secondary" href="/case-studies">More case studies</a>
				</div>
			</div>
		</aside>
	</div>
</BaseLayout>

<style>
	/* The aside stands off the page: a raised surface with a violet glow under it, and a border that
	   lights up where the pointer is (data-spotlight sets --mx and --my). It never tilts: it is sticky. */
	.panel {
		position: relative;
		border: 1px solid var(--rule);
		border-radius: 1rem;
		/* Solid, so axe can check the contrast of the text on it. */
		background: var(--surface);
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, var(--accent) 22%, transparent),
			0 30px 60px -40px color-mix(in srgb, var(--glow) 70%, transparent);
	}
	.panel::after {
		content: '';
		position: absolute;
		inset: -1px;
		padding: 1.5px;
		border-radius: inherit;
		background: radial-gradient(16rem circle at var(--mx, 50%) var(--my, 0%), var(--accent), transparent 65%);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box exclude,
			linear-gradient(#000 0 0);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}
	.panel:hover::after,
	.panel:focus-within::after {
		opacity: 1;
	}
	/* A headline result gets the accent tick that cards use; green is kept for real test results. */
	.headline {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}
	.headline svg {
		flex: none;
		align-self: center;
		fill: none;
		stroke: var(--accent);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
