---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EntryMeta from '../../components/EntryMeta.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
	<Fragment slot="hero">
		<p class="mb-5"><a class="link" href="/projects">All projects</a></p>
		<h1 class="title-long">{project.data.title}</h1>
		<p class="lede">{project.data.summary}</p>
		<EntryMeta date={project.data.date} tags={project.data.tags} />
		<ul class="mt-8 grid gap-3 sm:flex sm:flex-wrap">
			<li><ExternalLink class="btn btn-primary w-full" href={project.data.repo}>Source code</ExternalLink></li>
			{
				project.data.live && (
					<li>
						<ExternalLink class="btn btn-secondary w-full" href={project.data.live}>
							Live site
						</ExternalLink>
					</li>
				)
			}
		</ul>
	</Fragment>
	<article class="prose">
		<Content />
	</article>
</BaseLayout>
