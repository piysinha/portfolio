---
// Home's terminal replay as a glass slab, with the latest HTML report and its traces stacked behind it
// like tabs in a file. The tabs link to the latest Gate run's report once TestRunReplay has loaded the
// results, and to the Quality dashboard until then (or if the results can't load).
import TestRunReplay from './TestRunReplay.astro';
---

<div class="stack" data-tilt="8" data-testid="terminal-stack">
	<div class="stack-inner">
		<a class="tab tab-trace" href="/quality" data-latest-report><strong>Traces</strong><span>Step through any test</span></a>
		<a class="tab tab-report" href="/quality" data-latest-report><strong>HTML report</strong><span>Latest Gate run</span></a>
		<div class="front"><TestRunReplay /></div>
	</div>
</div>

<script>
	// On touch screens there is no hover, so the tabs fan out as the stack scrolls up to the middle
	// of the screen instead. Not for reduced motion.
	const stack = document.querySelector<HTMLElement>('.stack');
	if (stack && matchMedia('(hover: none)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let queued = false;
		const update = () => {
			queued = false;
			const box = stack.getBoundingClientRect();
			const progress = (innerHeight - box.top) / (innerHeight / 2 + box.height / 2);
			stack.style.setProperty('--p', Math.min(Math.max(progress, 0), 1).toFixed(3));
		};
		addEventListener(
			'scroll',
			() => {
				if (!queued) requestAnimationFrame(update);
				queued = true;
			},
			{ passive: true },
		);
		update();
	}
</script>

<style>
	/* --p is how far the tabs have fanned out: 1 under the pointer or keyboard focus. */
	.stack {
		--p: 0;
		--rx: 0deg;
		--ry: 0deg;
		--fan: calc(0.85 + var(--p) * 0.2);
		/* Room above for the tabs. */
		margin-top: 6.5rem;
		margin-right: 2rem;
		perspective: 1400px;
	}
	.stack:hover,
	.stack:focus-within {
		--p: 1;
	}
	.stack-inner {
		position: relative;
		transform: rotateX(calc(8deg + var(--rx))) rotateY(calc(-14deg + var(--ry)));
		transform-style: preserve-3d;
	}
	.front {
		position: relative;
		border-radius: 1.25rem;
		box-shadow: 0 40px 90px -36px color-mix(in srgb, var(--glow) 90%, transparent);
	}
	/* A sheen across the glass. */
	.front::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(115deg, rgb(255 255 255 / 0.1), transparent 32%, transparent 70%, rgb(255 255 255 / 0.05));
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12);
		pointer-events: none;
	}
	.tab {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding: 0.75rem 1.1rem;
		border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--rule));
		border-radius: 1.25rem;
		background: color-mix(in srgb, var(--surface) 88%, var(--accent));
		box-shadow: 0 24px 50px -30px color-mix(in srgb, var(--glow) 70%, transparent);
		color: var(--ink);
		font-size: 0.8125rem;
		text-decoration: none;
	}
	.tab strong {
		font-size: 0.875rem;
		font-stretch: 110%;
	}
	.tab span {
		color: var(--ink-2);
	}
	.tab:hover {
		border-color: var(--accent);
	}
	.tab-report {
		transform: translate3d(calc(var(--fan) * 0.6rem), calc(var(--fan) * -3.4rem), -50px);
	}
	.tab-trace {
		transform: translate3d(calc(var(--fan) * 1.2rem), calc(var(--fan) * -6.8rem), -100px);
	}
	/* A focused tab comes to the front, so its whole focus ring shows. */
	.tab:focus-visible {
		z-index: 1;
		border-color: var(--accent);
		transform: translate3d(0, -1rem, 40px);
	}
	@media (prefers-reduced-motion: no-preference) {
		.stack-inner,
		.tab {
			transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
		}
	}
	/* Phones: less turn, so the terminal keeps its width. */
	@media (max-width: 39.999rem) {
		.stack {
			margin-right: 0.75rem;
		}
		.stack-inner {
			transform: rotateX(calc(6deg + var(--rx))) rotateY(calc(-6deg + var(--ry)));
		}
	}
</style>
