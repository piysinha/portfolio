---
// Home's track record: three headline career results. Figures count up once they scroll into view
// (see the motion script in BaseLayout); screen readers and the settled page get the final figure.
const results = [
	{ from: 0, to: 4.5, decimals: 1, before: '', after: '+ years', claim: 'building Playwright and TypeScript automation for web apps and APIs.' },
	{ from: 240, to: 90, decimals: 0, before: '', after: ' min', claim: 'for a full regression run, down from 4 hours after a Selenium-to-Playwright migration.' },
	{ from: 0, to: 55, decimals: 0, before: '~', after: '% fewer', claim: 'flaky failures, from auto-waiting locators, reusable login state and fixes found in traces.' },
];
---

<section class="track" aria-labelledby="track-heading">
	<h2 id="track-heading" class="sr-only">Track record</h2>
	<ul class="track-list">
		{
			results.map(({ from, to, decimals, before, after, claim }, i) => (
				<li class="track-item" data-reveal style={`--d:${i}`}>
					<span class="mark" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="16" height="16">
							<path class="tick" d="M5 12.5l4.5 4.5L19 7.5" />
						</svg>
					</span>
					<p class="figure">
						<span class="sr-only">{`${before}${to.toFixed(decimals)}${after}`}</span>
						{/* On one line: whitespace here would show up between the figure and its unit. */}
						<span aria-hidden="true">{before}<span data-count-to={to} data-count-from={from} data-decimals={decimals}>{to.toFixed(decimals)}</span>{after}</span>
					</p>
					<p class="claim">{claim}</p>
				</li>
			))
		}
	</ul>
</section>

<style>
	.track-list {
		display: grid;
		border: 1px solid var(--rule);
		border-radius: 1.25rem;
		background: var(--surface);
	}
	@media (min-width: 48rem) {
		.track-list {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.track-item {
		display: grid;
		grid-template-columns: 1.75rem 1fr;
		column-gap: 0.85rem;
		align-content: start;
		padding: 1.25rem 1.25rem 1.35rem;
	}
	.track-item + .track-item {
		border-top: 1px solid var(--rule);
	}
	@media (min-width: 48rem) {
		.track-item {
			padding: 1.6rem 1.6rem 1.75rem;
		}
		.track-item + .track-item {
			border-top: 0;
			border-left: 1px solid var(--rule);
		}
	}
	.mark {
		display: grid;
		grid-row: span 2;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		margin-top: 0.3rem;
		border-radius: 50%;
		background: var(--accent-soft);
		color: var(--accent);
	}
	.mark svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.figure {
		font-size: clamp(1.75rem, 5vw, 2.25rem);
		font-stretch: 118%;
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}
	.claim {
		margin-top: 0.35rem;
		color: var(--ink-2);
		font-size: 0.975rem;
		line-height: 1.5;
	}
	/* Each tick draws once its result has scrolled into view. */
	@media screen and (prefers-reduced-motion: no-preference) {
		:global(.js) .tick {
			stroke-dasharray: 22;
			stroke-dashoffset: 22;
			transition: stroke-dashoffset 0.5s ease-out;
			transition-delay: calc(0.25s + var(--d) * 0.12s);
		}
		:global(.js) .is-in .tick {
			stroke-dashoffset: 0;
		}
	}
</style>
