---
// Home's track record: headline career results, then one live line read from this site's own Test runs.
// The live line starts as what the release gate guarantees (no counts) and updates once results load.
import { guaranteedCheck } from '../lib/release-check';

const claims = [
	{
		claim: '4.5+ years building Playwright and TypeScript automation',
		detail: 'For web apps and APIs, at Cognizant and now at Aumni Techworks.',
	},
	{
		claim: 'Regression runs cut from 4 hours to 90 minutes',
		detail: 'By moving a legacy Selenium suite to Playwright, with parallel workers in CI.',
	},
	{
		claim: 'About 55% fewer flaky failures',
		detail: 'From auto-waiting locators, reusable login state and fixes found in traces.',
	},
];
---

<section class="track" aria-labelledby="track-heading">
	<h2 id="track-heading" class="track-heading">Track record</h2>
	<ul class="checks">
		{
			claims.map(({ claim, detail }, i) => (
				<li class="check" style={`--i:${i}`}>
					<span class="mark mark-claim" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="16" height="16">
							<path class="tick" d="M5 12.5l4.5 4.5L19 7.5" />
						</svg>
					</span>
					<div>
						<p class="claim">{claim}</p>
						<p class="detail">{detail}</p>
					</div>
				</li>
			))
		}
		<li class="check live" style={`--i:${claims.length}`} data-release-check data-state={guaranteedCheck.state}>
			<span class="mark mark-live" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="16" height="16">
					<path class="tick" d="M5 12.5l4.5 4.5L19 7.5" />
					<path class="cross" d="M7 7l10 10M17 7 7 17" />
					<circle class="dot" cx="12" cy="12" r="3.5" />
				</svg>
			</span>
			<div>
				<p class="live-label">Live from this site's tests</p>
				<p class="claim" data-claim>{guaranteedCheck.claim}</p>
				<p class="detail" data-detail>{guaranteedCheck.detail}</p>
				<p class="mt-3"><a class="link" href="/quality">See the test results</a></p>
			</div>
		</li>
	</ul>
</section>

<script>
	import { dashboardView } from '../lib/quality-dashboard';
	import { releaseCheck } from '../lib/release-check';
	import { reports } from '../lib/site';

	const line = document.querySelector<HTMLElement>('[data-release-check]');

	async function load() {
		if (!line) return;
		try {
			const response = await fetch(reports.summaryUrl, { cache: 'no-store' });
			if (!response.ok) return;
			const check = releaseCheck(dashboardView(await response.json(), new Date()));
			line.dataset.state = check.state;
			line.querySelector('[data-claim]')!.textContent = check.claim;
			line.querySelector('[data-detail]')!.textContent = check.detail;
		} catch {
			// The reports site is unreachable: the line keeps stating what the release gate guarantees.
		}
	}

	load();
</script>

<style>
	.track {
		padding: 1.5rem 1.25rem 1.4rem;
		border: 1px solid var(--rule);
		border-radius: 1.25rem;
		background: var(--surface);
	}
	@media (min-width: 40rem) {
		.track {
			padding: 1.75rem 1.75rem 1.6rem;
		}
	}
	.track-heading {
		color: var(--ink-2);
		font-size: 0.9375rem;
		font-weight: 650;
	}
	.checks {
		display: grid;
		margin-top: 0.5rem;
	}
	.check {
		display: grid;
		grid-template-columns: 1.75rem 1fr;
		gap: 0.85rem;
		padding-block: 1rem;
		border-bottom: 1px solid var(--rule);
	}
	.check:last-child {
		padding-bottom: 0.25rem;
		border-bottom: 0;
	}
	.mark {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		margin-top: 0.05rem;
		border-radius: 50%;
	}
	.mark svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.mark-claim {
		background: var(--accent-soft);
		color: var(--accent);
	}
	/* Each tick is drawn in turn, once, as the page loads. */
	.tick {
		stroke-dasharray: 22;
		stroke-dashoffset: 22;
		animation: draw 0.4s ease-out forwards;
		animation-delay: calc(0.45s + var(--i) * 0.2s);
	}
	.claim {
		color: var(--ink);
		font-size: 1.0625rem;
		font-weight: 650;
		line-height: 1.35;
	}
	.detail {
		margin-top: 0.2rem;
		color: var(--ink-2);
		font-size: 0.9375rem;
		line-height: 1.5;
	}
	.live-label {
		margin-bottom: 0.2rem;
		color: var(--ink-2);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	/* The live line: green tick, red cross, or a neutral dot while no result is known. */
	.mark-live {
		border: 1.5px solid var(--rule);
		color: var(--ink-2);
	}
	.mark-live .tick,
	.mark-live .cross,
	.mark-live .dot {
		display: none;
	}
	.live[data-state='unknown'] .dot {
		display: inline;
		fill: currentColor;
		stroke: none;
	}
	.live[data-state='passed'] .mark-live {
		border-color: transparent;
		background: var(--pass);
		color: var(--surface);
	}
	.live[data-state='passed'] .tick {
		display: inline;
	}
	.live[data-state='failed'] .mark-live {
		border-color: transparent;
		background: var(--fail);
		color: var(--surface);
	}
	.live[data-state='failed'] .cross {
		display: inline;
	}

	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}
</style>
