---
// Depth behind every page's hero (BaseLayout puts it there): a grid floor laid back in perspective, and a violet glow that drifts
// towards the pointer. Decoration only, so it is hidden from assistive technology and never takes clicks.
---

<div class="hero-backdrop" aria-hidden="true">
	<div class="floor"><div class="grid"></div></div>
	<div class="glow"></div>
</div>

<script>
	// The glow follows the pointer, easing there through a CSS transition. Not for reduced motion.
	const backdrop = document.querySelector<HTMLElement>('.hero-backdrop');
	if (backdrop && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		addEventListener('pointermove', (event) => {
			if (event.pointerType !== 'mouse') return;
			const box = backdrop.getBoundingClientRect();
			backdrop.style.setProperty('--gx', `${event.clientX - box.left}px`);
			backdrop.style.setProperty('--gy', `${event.clientY - box.top}px`);
		});
	}
</script>

<style>
	/* Fills its positioned parent and reaches out to the page edge; html clips the overflow. */
	.hero-backdrop {
		position: absolute;
		z-index: -1;
		inset: -5rem calc(50% - 50vw) -6rem;
		overflow: hidden;
		pointer-events: none;
		/* Fades out into the page below, so there is no edge where the hero ends. */
		-webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
		mask-image: linear-gradient(to bottom, #000 55%, transparent);
	}
	.floor {
		position: absolute;
		right: -40%;
		bottom: 22%;
		left: -40%;
		height: 60%;
		overflow: hidden;
		transform: perspective(700px) rotateX(64deg);
		transform-origin: bottom;
		-webkit-mask-image: linear-gradient(to top, #000, transparent 80%);
		mask-image: linear-gradient(to top, #000, transparent 80%);
	}
	/* One cell taller than the floor, so it can drift down a cell and loop without a seam. */
	.grid {
		position: absolute;
		inset: -56px 0 0;
		background-image:
			linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
			linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
		background-size: 56px 56px;
	}
	.glow {
		position: absolute;
		top: calc(var(--gy, 45%) - 30vmax);
		left: calc(var(--gx, 70%) - 30vmax);
		width: 60vmax;
		aspect-ratio: 1;
		background: radial-gradient(closest-side, color-mix(in srgb, var(--glow) 30%, transparent), transparent);
	}
	@media (prefers-reduced-motion: no-preference) {
		/* A transform, not background-position, so the drift never repaints the page. */
		.grid {
			animation: drift 6s linear infinite;
		}
		.glow {
			transition:
				top 1.2s cubic-bezier(0.2, 0.8, 0.2, 1),
				left 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
		}
	}
	@keyframes drift {
		to {
			translate: 0 56px;
		}
	}
</style>
