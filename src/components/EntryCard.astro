---
import type { FeaturedItem } from '../lib/featured';
import EntryMeta from './EntryMeta.astro';

interface Props {
	title: string;
	href: string;
	summary: string;
	/** A headline result, shown with a tick. */
	highlight?: string;
	date: Date;
	tags: string[];
	/** Shown above the title where Projects and Case studies are mixed. */
	kind?: FeaturedItem['kind'];
	/** Heading level for the title, so cards nest under their section's heading. */
	level?: 2 | 3;
	/** A card for grids, or a row for a single-column list. */
	layout?: 'card' | 'row';
}

const { title, href, summary, highlight, date, tags, kind, level = 2, layout = 'card' } = Astro.props;
const Heading = `h${level}` as const;
---

<article class:list={['entry-card', { 'is-row': layout === 'row' }]}>
	{kind && <p class="entry-kind" data-testid="kind">{kind}</p>}
	<Heading><a href={href}>{title}</a></Heading>
	<p data-testid="summary">{summary}</p>
	{
		highlight && (
			<p class="entry-highlight">
				<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
					<path d="M5 12.5l4.5 4.5L19 7.5" />
				</svg>
				{highlight}
			</p>
		)
	}
	<EntryMeta date={date} tags={tags} />
</article>

<style>
	.entry-highlight {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: fit-content;
		padding: 0.3rem 0.65rem 0.3rem 0.45rem;
		border-radius: 0.5rem;
		background: var(--accent-soft);
		color: var(--ink);
		font-size: 0.9375rem;
		font-weight: 650;
		line-height: 1.35;
	}
	.entry-highlight svg {
		flex: none;
		fill: none;
		stroke: var(--accent);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
